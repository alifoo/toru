PUBLIC_URL=https://recorder.example.com
# Your public site and console, if you self-host them; the defaults are the hosted service's. Keep
# TORU_SITE_URL equal to the console's NEXT_PUBLIC_SITE_URL.
# TORU_SITE_URL=https://toru.example.com
# TORU_APP_URL=https://app.toru.example.com
PORT=3002
DATA_DIR=/data
# Private hosted deployment only: RECORDER_MODE=hosted (default engine has no commercial credits).
# Fresh beta volume: deploy once with RECORDER_MODE=init-empty, verify /healthz
# reports empty_initialized, then redeploy the same service with hosted.
# A volume is bound to this environment/instance on its first runtime startup.
RECORDER_ENVIRONMENT=production
RECORDER_INSTANCE_ID=recorder-production
# Operator/service identity responsible for policy configuration; never a credential.
POLICY_ACTOR=
# Railway supplies RAILWAY_DEPLOYMENT_ID; elsewhere set a unique ID per configuration deploy.
# RECORDER_DEPLOYMENT_ID=deploy-2026-09-27-001
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
# Keep private; used only by the invite provisioning endpoint.
INVITE_ADMIN_KEY=
RENDER_BROWSER_BINARY=/usr/bin/chromium
RENDER_BUNDLE_DIRECTORY=/app/apps/render-worker/dist-web
# Set only on a host that exposes a real GPU; software WebGL falls back automatically.
RENDER_BACKEND=
# Public hosted use requires a working Chromium sandbox or independently verified per-run isolation.
# Do not enable this merely to work around a host permission error.
CHROME_NO_SANDBOX=0
# Hosted staging/production requires a per-job Railway Sandbox runtime. The checkpoint
# must contain a pinned Linux/amd64 worker image and /opt/recorder/seccomp.json.
# Do not set these until the VM isolation and recovery acceptance has passed.
# HOSTED_WORKER_MODE=railway
# HOSTED_WORKER_CHECKPOINT=recorder-worker-release-1
# HOSTED_WORKER_IMAGE_SHA256=sha256:...
# RAILWAY_TOKEN=  # project-scoped token for this environment
# RAILWAY_ENVIRONMENT_ID=  # Railway environment UUID

# Console (any Next.js host)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
RECORDER_URL=https://recorder.example.com
RECORDER_ADMIN_KEY=
NEXT_PUBLIC_RECORDER_URL=https://recorder.example.com
# NEXT_PUBLIC_SITE_URL=https://toru.example.com
# NEXT_PUBLIC_APP_URL=https://app.toru.example.com
# The public repository. Every open-source mention on the site (nav, pricing, FAQ) appears only when it is set.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/owner/toru
# Expose the paid button only after production Stripe account, Price, webhook,
# reconciler and portal are configured. Keep both flags false until that cutover.
NEXT_PUBLIC_CREATOR_CHECKOUT_ENABLED=false
RECORDER_CREATOR_CHECKOUT_ENABLED=false
# Credit packs (F5): placeholder prices in packages/hosted-policy/src/packs.ts. Keep off until the Stripe one-time prices exist.
NEXT_PUBLIC_CREDIT_PACKS_ENABLED=false
RECORDER_CREDIT_PACKS_ENABLED=false
# HOSTED_STRIPE_PACKS=[{"id":"pack-1","priceId":"price_...","productId":"prod_..."},{"id":"pack-15",...},{"id":"pack-30",...}]

# Private hosted billing. `test` is local/staging only; `live` is production only.
# Leave HOSTED_CHECKOUT_MODE unset until the matching webhook destination works.
# HOSTED_CHECKOUT_MODE=live
# HOSTED_STRIPE_ACCOUNT_ID=acct_...
# HOSTED_STRIPE_LIVEMODE=true
# HOSTED_STRIPE_SECRET_KEY=sk_live_...
# HOSTED_STRIPE_WEBHOOK_SECRETS=whsec_...
# HOSTED_STRIPE_CREATOR_PRODUCT_ID=prod_...
# HOSTED_STRIPE_CREATOR_PRICE_ID=price_...
# HOSTED_STRIPE_STUDIO_PRICE_ID=price_...
# HOSTED_STRIPE_STUDIO_PRODUCT_ID=prod_...
# HOSTED_STRIPE_CREATOR_AMOUNT_MINOR=1900
# HOSTED_STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# HOSTED_CHECKOUT_RETURN_ORIGIN=https://toru.example.com/

# Optional server-side Jev navigation; manual MCP controls work without this key.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Estimated cumulative model spend per browser session, shared by successive goals.
JEV_MAX_USD=0.25

# Operational guardrails, shared by all tokens for an owner; reset at 00:00 UTC.
# These are not paid-plan entitlements. Worst-case time is reserved before work.
DAILY_BROWSER_MINUTES=60
DAILY_RENDER_MINUTES=30
DAILY_SESSION_LIMIT=10
DAILY_SERVICE_SESSION_LIMIT=50

# Private hosted service only. Maximum concurrently admitted beta accounts.
# Lowering the limit does not evict already admitted accounts; 0 pauses new admission.
HOSTED_BETA_CAPACITY=25
# Aggregate hosted render budget across all accounts, including reserved in-flight time.
HOSTED_DAILY_RENDER_MINUTES=120
# Event classification for this deployment; defaults to unclassified, never inferred as real adoption.
# Local console uses internal; smoke launcher forces fixture. Use the private cohort CLI for per-account overrides in mixed deployments.
HOSTED_USAGE_COHORT=unclassified
# Hosted restore protection: a dedicated private S3-compatible bucket, separate from the volume.
# Initialize its identity manifest deliberately before hosted staging/production startup.
# HOSTED_DELETION_BUCKET=
# HOSTED_DELETION_BUCKET_ENDPOINT=
# HOSTED_DELETION_BUCKET_REGION=auto
# HOSTED_DELETION_BUCKET_ACCESS_KEY_ID=
# HOSTED_DELETION_BUCKET_SECRET_ACCESS_KEY=
# Stopped-service maintenance only: RECORDER_MODE=backup-legacy.
# Use a second private bucket, distinct from HOSTED_DELETION_BUCKET. Record the
# printed manifest SHA-256 and verify a restore before setting bootstrap flags.
# HOSTED_BACKUP_BUCKET=
# HOSTED_BACKUP_BUCKET_ENDPOINT=
# HOSTED_BACKUP_BUCKET_REGION=auto
# HOSTED_BACKUP_BUCKET_ACCESS_KEY_ID=
# HOSTED_BACKUP_BUCKET_SECRET_ACCESS_KEY=
# HOSTED_LEGACY_BACKUP_ID=uuid_for_this_cutover
# Explicit operator expiry period, 1..365 days; no default or automatic schedule.
# HOSTED_BACKUP_RETENTION_DAYS=
# Stopped-service SQL + retained-media backup: RECORDER_MODE=backup-volume.
# Uses the same private backup bucket, under a separate namespace.
# HOSTED_VOLUME_BACKUP_ID=unique_uuid_for_this_snapshot
# Offline restore to a new directory; requires the matching deletion bucket for replay.
# HOSTED_VOLUME_BACKUP_MANIFEST_SHA256=64_hex_chars_from_backup_receipt
# HOSTED_VOLUME_RESTORE_DIR=/private/secure/recorder-volume-restore
# Offline restore CLI only, to a new path outside DATA_DIR:
# HOSTED_LEGACY_BACKUP_MANIFEST_SHA256=64_hex_chars_from_backup_receipt
# HOSTED_LEGACY_RESTORE_DIR=/private/secure/recorder-restore
# One-time cutover only, with a separately verified off-volume backup of /data.
# Removes legacy JSON after a checked SQL migration and binds the bucket manifest.
# Remove this variable immediately after the first successful hosted startup.
# HOSTED_BOOTSTRAP_LEGACY=reviewed
# HOSTED_LEGACY_SNAPSHOT_SHA256=64_hex_chars_from_storage_cli_inspect_legacy
# Local/offline tests only; Railway cannot mount a second persistent volume on this service.
# HOSTED_DELETION_JOURNAL=/erasure-journal

# Hosted MCP OAuth (same Clerk instance as the console); omit for manual-token-only engine.
CLERK_OAUTH_ISSUER=https://clerk.example.com
CLERK_SECRET_KEY=

# Local browser companion is the default. Set to 0 only to disable it.
# LOCAL_BROWSER_ENABLED=0
