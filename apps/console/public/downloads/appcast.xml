  <item>
   <title>Toru 0.4.0</title>
   <pubDate>Mon, 12 Oct 2026 16:20:26 GMT</pubDate>
   <sparkle:version>4</sparkle:version>
   <sparkle:shortVersionString>0.4.0</sparkle:shortVersionString>
   <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
   <sparkle:channel>beta</sparkle:channel>
   <description><![CDATA[<ul><li>Recordings keep a margin around the window and are rendered on a light backdrop, so menus that open past the window show whole</li><li>Toru sees open menus and controls apps draw without accessibility labels (Apple Books' Sections menu)</li><li>Code editors (Cursor, VS Code): types into the open document and scrolls web previews</li><li>Typing resumes if another app comes to the front mid-sentence</li></ul>]]></description>
   <enclosure url="https://toru.tools/downloads/mac/Toru-0.4.0.zip" length="1861829" type="application/octet-stream"/>
  </item>
